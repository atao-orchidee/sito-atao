# Solo per la configurazione iniziale del CMS online (PUBBLICAZIONE.md, passo 3):
# PUBLIC_CMS_GITHUB=si

# Chiavi del CMS Keystatic in modalità GitHub.
# Non vanno scritte qui: le crea Keystatic la prima volta (vedi PUBBLICAZIONE.md, passo 3)
# e vanno copiate nelle variabili d'ambiente di Netlify.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
