---
// Scheda di un'orchidea nel catalogo, impostata come un'etichetta d'erbario.
import type { CollectionEntry } from 'astro:content';
import Foto from './Foto.astro';
import NomeBotanico from './NomeBotanico.astro';

interface Props { orchidea: CollectionEntry<'orchidee'>; priorita?: boolean }
const { orchidea, priorita = false } = Astro.props;
const { nome, collezione, foto } = orchidea.data;
---
<article class="scheda">
  <a href={`/orchidee/${orchidea.id}/`} class="collegamento">
    <Foto immagine={foto[0]?.immagine} alt={foto[0]?.didascalia ?? nome} sizes="(min-width: 75rem) 18vw, (min-width: 40rem) 30vw, 50vw" larghezze={[240, 360, 480, 640]} priorita={priorita} transizione={`foto-${orchidea.id}`} />
    <div class="etichetta">
      <h3 class="nome"><NomeBotanico nome={nome} /></h3>
      {collezione && <p class="piccolo">Collezione di {collezione}</p>}
    </div>
  </a>
</article>

<style>
  .collegamento { display: block; color: inherit; text-decoration: none; height: 100%; }
  .etichetta { border: 1px solid var(--radice); border-top: 0; background: var(--carta); padding: 0.75rem 0.9rem 0.9rem; border-radius: 0 0 4px 4px; }
  .collegamento :global(.foto) { border-radius: 4px 4px 0 0; }
  .nome { font-size: var(--t-m); font-weight: 400; line-height: 1.3; margin: 0 0 0.25rem; }
  .piccolo { margin: 0; }
  .collegamento:hover .nome { color: var(--labello); }
  .collegamento:hover .etichetta { border-color: var(--foglia); }
</style>
