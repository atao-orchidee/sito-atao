// Configurazione di Cloudflare Workers: sito statico in dist/ più il Worker del CMS (/keystatic, /api/keystatic).
{
  "name": "sito-atao",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
    // Le pagine del CMS non sono file: senza questa riga i browser ricevono la pagina "non trovata".
    "run_worker_first": ["/keystatic", "/keystatic/*", "/api/*"]
  },
  "observability": { "enabled": true }
}
